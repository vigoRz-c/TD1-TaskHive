# ============================================================
#  TaskHive - fichier de configuration (lu par docker compose)
#  Modifier ce fichier suffit : aucun changement de code requis.
# ============================================================

# ---------- Application ----------
PORT=3000
# Secret de signature des jetons JWT : À CHANGER en production (chaîne longue et aléatoire)
JWT_SECRET=change-me-dev-only-7f3a9c1e5b2d4f6a8c0e2b4d6f8a1c3e
JWT_EXPIRES_IN=8h
# Crée 2 entreprises de démonstration au premier démarrage (base vide)
SEED_DEMO=true

# ---------- Base MongoDB ----------
# Compte root créé par l'image mongo au premier démarrage (valeurs de développement)
MONGO_INITDB_ROOT_USERNAME=taskhive
MONGO_INITDB_ROOT_PASSWORD=taskhive-dev-password

# Chaîne de connexion utilisée par l'application.
MONGO_URI=mongodb://taskhive:taskhive-dev-password@mongo:27017/?authSource=admin

MONGO_DB_NAME=taskhive
MONGO_MAX_POOL_SIZE=20
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000
MONGO_CONNECT_RETRIES=20
MONGO_CONNECT_RETRY_DELAY_MS=3000

# ---------- Administrateur de la plateforme ----------
# Compte hors entreprise qui gère l'application et accède à toutes les entreprises.
# Seul le hash bcrypt du mot de passe est stocké (entre apostrophes : pas d'interprétation des $).
# Générer un nouveau hash : docker compose exec app node -e "console.log(require('bcryptjs').hashSync('MOT_DE_PASSE', 12))"
# Laissé vide ici : avec SEED_DEMO=true, le compte de démonstration admin@taskhive.test / demo1234
# joue déjà ce rôle. Renseigner ces deux valeurs pour créer le vrai compte d'administration.
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD_HASH=
